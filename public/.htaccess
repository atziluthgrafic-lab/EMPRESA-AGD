# --- CONFIGURACIÓN DE ATZILUTH GRAFIC DIGITAL PARA HOSTINGER ---

# 1. EVITAR LISTADO DE DIRECTORIOS (Seguridad)
Options -Indexes

# 1b. DATOS PRIVADOS: nunca se descargan desde la web (los archivos NO se borran, solo se bloquean)
<FilesMatch "^(proveedores_.*|clients_data|sellers_data|sales_orders_data|leads_data)\.json$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(bak|hash|md|ts|lock)$">
  Require all denied
</FilesMatch>

# 1c. CACHÉ: las páginas y los datos se revisan SIEMPRE con el servidor (así se ven los cambios al publicar);
#     los archivos de /assets llevan un código único en el nombre y se pueden guardar un año.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|json|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "^index-[A-Za-z0-9_-]+\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 2. CONFIGURACIÓN DE MIME-TYPES (Evita errores de carga de CSS/JS en Apache/Hostinger)
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType text/css .css
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType image/jpeg .jpg .jpeg
  AddType image/png .png
  AddType image/x-icon .ico
</IfModule>

# 3. REDIRECCIÓN SPA (SINGLE PAGE APPLICATION) Y API
# Redirige todas las peticiones de API a nuestro backend de PHP, y el resto no existente a index.html
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Redirigir peticiones de la API a api/index.php de manera limpia
  RewriteRule ^api/(.*)$ api/index.php?route=$1 [QSA,L]
  
  # Si el archivo o directorio solicitado existe físicamente, sírvelo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  
  # Si no existe, redirige todo el tráfico a index.html para que el enrutador de React tome el control
  RewriteRule ^ index.html [L]
</IfModule>

# 4. COMPRESIÓN GZIP (Optimización de velocidad de carga en Hostinger)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
